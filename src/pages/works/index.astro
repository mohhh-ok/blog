---
import WorkCard from "@/components/WorkCard.astro";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const works = (await getCollection("works", ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => {
    const now = new Date();
    const aEnd = (a.data.endDate ?? (a.data.startDate ? now : new Date(a.data.aboutYear ?? 0, 0))).valueOf();
    const bEnd = (b.data.endDate ?? (b.data.startDate ? now : new Date(b.data.aboutYear ?? 0, 0))).valueOf();

    if (bEnd !== aEnd) return bEnd - aEnd;

    const aStart = a.data.startDate?.valueOf() ?? 0;
    const bStart = b.data.startDate?.valueOf() ?? 0;
    return bStart - aStart;
  },
);
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <BaseHead
      title={`Works - ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
      noIndex={true}
    />
  </head>
  <body>
    <Header />
    <main class="w-[min(1600px,calc(100%-2rem))] mx-auto px-4">
      <h1>Works</h1>
      <section class="grid gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          works.map((work) => <WorkCard work={work} />)
        }
      </section>
    </main>
    <Footer />
  </body>
</html>

