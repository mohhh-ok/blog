---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import WorkCard from "../components/WorkCard.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { PATHS } from "../paths";

const showEntry = ({ data }: { data: { draft: boolean } }) =>
  import.meta.env.DEV || !data.draft;

const posts = (await getCollection("blog", showEntry))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);

// 載せる作品と並び順は works の frontmatter の featured で決める（docs/home.md）
const featuredWorks = (await getCollection("works", showEntry))
  .filter((work) => work.data.featured !== undefined)
  .sort((a, b) => (a.data.featured ?? 0) - (b.data.featured ?? 0));
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="home">
      <section class="intro">
        <p>
          フリーランスエンジニアのmohです。TypeScriptを中心としたWebフルスタック開発のほか、Chrome拡張やデスクトップアプリ（Electron・Tauri）を作っています。AI活用のご相談もお受けしています。
        </p>
        <p>
          2026年2月からAIエージェントを実装の主力にしています。設計の判断は人が行い、セキュリティ・疎結合・保守性を軸にしています。
        </p>
      </section>

      <section>
        <h2>作ったもの</h2>
        <div class="grid gap-5 grid-cols-1 sm:grid-cols-2">
          {
            featuredWorks.map((work) => (
              <WorkCard
                work={work}
                summaryLines={2}
                showTechs={false}
                headingLevel="h3"
              />
            ))
          }
        </div>
        <p class="works-more">
          <a href={PATHS.works.index} class="primary-action">すべての作品を見る</a>
        </p>
      </section>

      <section>
        <h2>最近の投稿</h2>
        <ul class="recent-posts">
          {
            posts.map((post) => (
              <li>
                <span class="post-date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                <a href={PATHS.posts.post(post.id)}>
                  {post.data.draft && (
                    <span class="text-xs bg-yellow-400 text-black px-1 py-0.5 rounded mr-1">
                      DRAFT
                    </span>
                  )}
                  {post.data.title}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="posts-more">
          <a href={PATHS.posts.index}>記事一覧へ</a>
        </p>
      </section>

      <p class="libraries">
        TypeScript のライブラリや Claude Code のスキルも <a
          href="https://github.com/mohhh-ok"
          target="_blank"
          rel="noopener">GitHub</a
        > で公開しています。
      </p>
    </main>
    <Footer />
  </body>
</html>

<style>
  main.home {
    width: auto;
    max-width: min(960px, calc(100% - 2em));
  }
  .intro p {
    max-width: 40em;
  }
  .works-more {
    margin: 1.5rem 0 0;
    text-align: center;
  }
  .primary-action {
    display: inline-block;
    padding: 0.75rem 2rem;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    transition: background-color 0.15s;
  }
  .primary-action:hover {
    background: var(--accent-dark);
    color: #fff;
  }
  .recent-posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .recent-posts li {
    display: grid;
    grid-template-columns: 8.5em 1fr;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  .post-date {
    color: rgb(107, 114, 128);
    font-size: 0.875rem;
  }
  .posts-more {
    margin: 1rem 0 0;
    text-align: right;
  }
  .libraries {
    margin: 3rem 0 0;
  }
  @media (max-width: 640px) {
    .recent-posts li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
