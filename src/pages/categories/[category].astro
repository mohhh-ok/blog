---
// カテゴリ別の記事一覧の 1 ページ目（/blog/categories/<カテゴリ>/）。2 ページ目以降は [category]/page/[page].astro
import { CATEGORIES_TREE, flatCategoryTreeItems } from "@/categories";
import CategoryPostsPage from "@/components/CategoryPostsPage.astro";
import { getCategoryPostsPage } from "@/posts";

export function getStaticPaths() {
  return flatCategoryTreeItems(CATEGORIES_TREE).map(({ category }) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
const { posts, totalPages } = await getCategoryPostsPage(category, 1);
---

<CategoryPostsPage category={category} posts={posts} current={1} total={totalPages} />
