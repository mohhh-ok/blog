---
// 作品で使った技術の並び。押せる物に見えないよう、枠を付けずに小さい文字で「・」区切りにする
// 1 語ずつ折り返し、区切りの「・」は次の語の頭に付けて行末にぶら下がらないようにする
export type Props = {
  techs: string[];
  class?: string;
};

const { techs, class: className } = Astro.props;
---

<p class:list={["flex flex-wrap text-xs text-gray-500 m-0 leading-relaxed", className]}>
  {
    techs.map((tech, i) => (
      <span class="whitespace-nowrap">
        {i > 0 && "・"}
        {tech}
      </span>
    ))
  }
</p>
