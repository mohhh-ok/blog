---
// 記事の並びのページ送り（前へ・ページ番号・次へ）。番号は先頭・末尾・今のページの前後だけを出し、間は「…」にする
interface Props {
  current: number;
  total: number;
  /** n ページ目の URL */
  pageHref: (n: number) => string;
}

const { current, total, pageHref } = Astro.props;

const numbers: (number | "gap")[] = [];
for (let n = 1; n <= total; n++) {
  if (n === 1 || n === total || Math.abs(n - current) <= 1) {
    numbers.push(n);
  } else if (numbers[numbers.length - 1] !== "gap") {
    numbers.push("gap");
  }
}
---

{
  total > 1 && (
    <nav class="pagination" aria-label="ページ送り">
      {current > 1
        ? <a href={pageHref(current - 1)} rel="prev">前へ</a>
        : <span class="disabled">前へ</span>}
      {numbers.map((n) =>
        n === "gap"
          ? <span class="gap">…</span>
          : n === current
          ? <span class="current" aria-current="page">{n}</span>
          : <a href={pageHref(n)}>{n}</a>
      )}
      {current < total
        ? <a href={pageHref(current + 1)} rel="next">次へ</a>
        : <span class="disabled">次へ</span>}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.25rem;
    margin: 1.5rem 0 0;
  }
  .pagination a,
  .pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    padding: 0 0.5rem;
  }
  .pagination .current {
    font-weight: 700;
    color: rgb(var(--black));
    border-bottom: 2px solid var(--accent);
  }
  .pagination .disabled,
  .pagination .gap {
    color: rgb(156, 163, 175);
  }
  /* SP では 3〜11 ページ目の一番長い並び（9 個）でも 1 行に収める。押せる高さ 40px は保つ */
  @media (max-width: 640px) {
    .pagination {
      gap: 0;
    }
    .pagination a,
    .pagination span {
      min-width: 32px;
      padding: 0 0.25rem;
    }
  }
</style>
